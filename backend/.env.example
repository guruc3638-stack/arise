# ==============================================================================
# ARISE Backend Environment Configuration (Template)
# Copy this file to .env and configure secrets locally. NEVER commit .env.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
APP_NAME=ARISE
API_V1_STR=/api/v1
PORT=8000
HOST=127.0.0.1

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# PostgreSQL Database (Supabase or direct connection)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arise_db

# Supabase Auth & JWT Verification
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-offline-verification

# Storage Bucket (Private)
SUPABASE_STORAGE_BUCKET=study-materials
PDF_MAX_SIZE_BYTES=10485760

# XP Policy
XP_POLICY_VERSION=v1

# Isolated Judge Engine
JUDGE_SERVICE_URL=http://localhost:8080
JUDGE_SECRET_TOKEN=local-judge-dev-token
